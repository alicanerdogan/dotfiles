{
  "strict": true,
  "paths": {
    "rules": [
      {
        "action": "ask",
        "kind": "file",
        "path": "./.env"
      },
      {
        "action": "deny",
        "kind": "directory",
        "path": "~/.ssh"
      },
      {
        "action": "allow",
        "kind": "directory",
        "path": "./node_modules"
      },
      {
        "action": "allow",
        "kind": "directory",
        "path": "${TMPDIR}"
      },
      {
        "action": "allow",
        "kind": "directory",
        "path": "./.pi"
      },
      {
        "action": "allow",
        "kind": "directory",
        "path": "./.tmp"
      },
      {
        "action": "allow",
        "kind": "directory",
        "path": "${FNM_DIR}"
      },
      {
        "action": "allow",
        "kind": "directory",
        "path": "${FNM_MULTISHELL_PATH}"
      },
      {
        "action": "allow",
        "kind": "directory",
        "path": "${PNPM_HOME}"
      },
      {
        "action": "allow",
        "kind": "directory",
        "path": "${GOPATH}"
      }
    ]
  },
  "commands": {
    "rules": [],
    "promptWhen": "blocked"
  },
  "llm": {
    "provider": "opencode-go",
    "model": "deepseek-v4.1-flash",
    "timeoutMs": 30000,
    "userPrompt": "",
    "piPath": ""
  },
  "hooks": {
    "afterPrompt": "/opt/homebrew/bin/fish -c \"notify 'Awaiting user input'\""
  },
  "audit": {
    "enabled": true
  }
}
