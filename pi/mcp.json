{
  "mcpServers": {
    "svelte": {
      "command": "npx",
      "args": [
        "-y",
        "@sveltejs/mcp"
      ],
      "description": "Svelte 5 and SvelteKit documentation, autofixer, and playground tools.",
      "directTools": [
        "get-documentation",
        "list-sections",
        "playground-link",
        "svelte-autofixer"
      ]
    }
  }
}
